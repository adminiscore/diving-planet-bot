# =============================================================================
# Diving Planet Bot - PRO (Production) Environment (VPS)
# =============================================================================
# Copy to .env.pro on the VPS and fill in your values:
#   cp .env.pro.example .env.pro
# DATABASE_URL and REDIS_URL are overridden by docker-compose.vps.yml
# USE STRONG PASSWORDS IN PRODUCTION!
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
# Modelos: NO se ponen aqui. El valor por defecto de src/config.py ES el de PRE (y PRE
# los fija ademas en docker-compose.vps.yml). Ponerlos aqui solo para probar otro a proposito.
# Mapa de que usa cada uno: README.md, "LLM models".

# --- Observabilidad ---
# LangSmith esta RETIRADO (cuota agotada; activo, cada turno de PRE daba un 429).
# NO pongas LANGSMITH_* ni LANGCHAIN_TRACING_V2: langchain-core trae el cliente de
# LangSmith y vuelve a trazar con solo ver esas variables (HISTORY 0.29.11).
# Langfuse es opcional (plan gratuito superado, reinicia el 16-oct). Sin claves el
# bot no traza; la latencia se mide con [TURN_METRICS] (scripts/turn_metrics.py).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Jev (TypeSafe via OpenRouter) ---
# Senales del router y preguntas de opcion fija (src/agents/jev_router.py). Sin
# clave no se llama y decide el LLM de siempre. Se enciende por flag en el compose.
OPENROUTER_API_KEY=

# --- PostgreSQL (overridden by compose, set password here for reference) ---
DATABASE_URL=postgresql://postgres:STRONG_PASSWORD_HERE@dp-pro-postgres:5432/diving_planet

# --- Redis (overridden by compose) ---
REDIS_URL=redis://:STRONG_PASSWORD_HERE@dp-pro-redis:6379/0

# --- Chatwoot ---
CHATWOOT_BASE_URL=https://chatwoot.divingplanet.org
CHATWOOT_API_TOKEN=your-chatwoot-api-token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# --- App ---
APP_ENV=production
APP_PORT=8000
APP_LOG_LEVEL=WARNING
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en
