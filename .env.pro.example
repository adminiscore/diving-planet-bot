# =============================================================================
# Diving Planet Bot - PRO (Production) Environment (VPS)
# =============================================================================
# Copy to .env.pro on the VPS and fill in your values:
#   cp .env.pro.example .env.pro
# DATABASE_URL and REDIS_URL are overridden by docker-compose.vps.yml
# USE STRONG PASSWORDS IN PRODUCTION!
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LangSmith ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=diving-planet-bot-pro
LANGCHAIN_TRACING_V2=true

# --- PostgreSQL (overridden by compose, set password here for reference) ---
DATABASE_URL=postgresql://postgres:STRONG_PASSWORD_HERE@dp-pro-postgres:5432/diving_planet

# --- Redis (overridden by compose) ---
REDIS_URL=redis://:STRONG_PASSWORD_HERE@dp-pro-redis:6379/0

# --- Chatwoot ---
CHATWOOT_BASE_URL=https://chatwoot.divingplanet.org
CHATWOOT_API_TOKEN=your-chatwoot-api-token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# --- App ---
APP_ENV=production
APP_PORT=8000
APP_LOG_LEVEL=WARNING
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en
