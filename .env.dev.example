# =============================================================================
# Diving Planet Bot - DEV Environment (Local)
# =============================================================================
# Copy to .env and fill in your values:
#   cp .env.dev.example .env
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LangSmith (optional, for tracing) ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=diving-planet-bot-dev
LANGCHAIN_TRACING_V2=true

# --- PostgreSQL (Docker local) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diving_planet

# --- Redis (Docker local) ---
REDIS_URL=redis://localhost:6379/0

# --- Chatwoot (optional, start with: docker compose --profile chatwoot up -d) ---
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# --- App ---
APP_ENV=development
APP_PORT=8000
APP_LOG_LEVEL=DEBUG
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en
