# =============================================================================
# Diving Planet Bot - DEV Environment (Local)
# =============================================================================
# Copy to .env.dev and fill in your values, then run everything with it:
#   cp .env.dev.example .env.dev
#   ENV_FILE=.env.dev python -m scripts.<script>
# (sin ENV_FILE se carga `.env`; los tests van con ENV_FILE=.env.ci)
# =============================================================================

# --- OpenAI ---
# Misma config que PRE. Medir con otra da una linea base FALSA en las dos
# direcciones (HISTORY 0.29.9: con 0.50 / top-k 5 / gpt-4o salian 6 fallbacks de
# RAG donde PRE da 1).
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# PRE responde el RAG con gpt-4.1-mini (32 de 284 llamadas en la foto
# TURN_METRICS del 24-sep). Pendiente de confirmar contra el .env.pre del VPS.
# RAG_ANSWER_MODEL=gpt-4.1-mini

# --- RAG (valores de PRE; alli el umbral lo fija docker-compose.vps.yml) ---
RAG_TOP_K=8
# Cosine gate for text-embedding-3-small: 0.72 was too strict and caused
# false fallbacks on real matches (adaptive-diving, COP prices score ~0.6-0.67).
RAG_MIN_SCORE=0.40

# --- Observabilidad ---
# LangSmith esta RETIRADO (cuota agotada; activo, cada turno de PRE daba un 429).
# NO pongas LANGSMITH_* ni LANGCHAIN_TRACING_V2: langchain-core trae el cliente de
# LangSmith y vuelve a trazar con solo ver esas variables (HISTORY 0.29.11).
# Langfuse es opcional (plan gratuito superado, reinicia el 16-oct). Sin claves el
# bot no traza; la latencia se mide con [TURN_METRICS] (scripts/turn_metrics.py).
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Jev (TypeSafe via OpenRouter) ---
# Senales del router y preguntas de opcion fija (src/agents/jev_router.py). Sin
# clave no se llama y decide el LLM de siempre. Se enciende por flag en el compose.
OPENROUTER_API_KEY=

# --- Rondas sinteticas contra PRE (scripts/run_synthetic_pre.py) ---
# Token de API de un agente de Chatwoot de PRE.
SYNTH_CHATWOOT_TOKEN=

# --- PostgreSQL (Docker local) ---
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diving_planet

# --- Redis (Docker local) ---
REDIS_URL=redis://localhost:6379/0

# --- Chatwoot (optional, start with: docker compose --profile chatwoot up -d) ---
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# --- App ---
APP_ENV=development
APP_PORT=8000
APP_LOG_LEVEL=DEBUG
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en
