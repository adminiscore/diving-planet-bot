# =============================================================================
# Diving Planet Bot - Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# NEVER commit .env to version control!
# =============================================================================

# --- OpenAI ---
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- RAG ---
RAG_TOP_K=5
RAG_MIN_SCORE=0.72

# --- LangSmith (Observability) ---
LANGSMITH_API_KEY=lsv2-your-langsmith-key-here
LANGSMITH_PROJECT=diving-planet-bot
LANGCHAIN_TRACING_V2=true

# --- Supabase (PostgreSQL + pgvector) ---
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diving_planet

# --- Chatwoot ---
CHATWOOT_BASE_URL=http://localhost:3000
CHATWOOT_API_TOKEN=your-chatwoot-api-token
CHATWOOT_ACCOUNT_ID=1
CHATWOOT_INBOX_ID=1

# --- Twilio (WhatsApp Business API) - Configure later ---
# TWILIO_ACCOUNT_SID=your-twilio-sid
# TWILIO_AUTH_TOKEN=your-twilio-auth-token
# TWILIO_WHATSAPP_NUMBER=whatsapp:+573202301515

# --- Redis (Cache) ---
REDIS_URL=redis://localhost:6379/0

# --- App Settings ---
APP_ENV=development
APP_PORT=8000
APP_LOG_LEVEL=INFO
DEFAULT_LANGUAGE=es
SUPPORTED_LANGUAGES=es,en
